#!/bin/bash

if [ $# -ne 6 ];
then
    echo "usage: "$(basename $0) "[graph.vg] [graph.xg] [chunk_size] [context] [output_pdf] [dot|neato]"
    echo "requires vg, pdfunite (from pdftk) and dot (graphviz)"
    echo "first index the graph with `nvg index -x ...` and then choose a chunk size"
    exit
fi

vg=$1
xg=$2
chunk=$3
context=$4
out=$5
renderer=$6

h=$(nvg view $vg | grep ^S | cut -f 2 | sort -n | head -1)
t=$(nvg view $vg | grep ^S | cut -f 2 | sort -n | tail -1)

echo "generating pdfs"
for i in $(seq $h $chunk $t);
do
    s=$i
    e=$(echo $i + $chunk | bc)
    echo "generating pdf for $s to $e"
    if [ "$renderer" == "neato" ];
    then
        nvg find -x $xg -r $s:$e -c $context \
            | nvg mod -z - \
            | nvg view -dn - \
            | neato -Tpdf -o $out.tmp.$s
    elif [ "$renderer" == "mars" ];
    then
        nvg find -x $xg -r $s:$e -c $context \
            | nvg mod -z - \
            | nvg view -dn - \
            | mars -g -k $chunk \
            | neato -Tpdf -n -o $out.tmp.$s
    elif [ "$renderer" == "marsnopath" ];
    then
        nvg find -x $xg -r $s:$e -c $context \
            | nvg mod -z - \
            | nvg view -d - \
            | mars -g -k $chunk \
            | neato -Tpdf -n -o $out.tmp.$s
    elif [ "$renderer" == "marspath" ];
    then
         nvg find -x $xg -r $s:$e -c $context \
            | nvg mod -z - \
            | nvg view -dpn - \
            | mars -g -k $chunk \
            | neato -Tpdf -n -o $out.tmp.$s
    elif [ "$renderer" == "marssimple" ];
    then
         nvg find -x $xg -r $s:$e -c $context \
            | nvg mod -z - \
            | nvg view -dpS - \
            | mars -g -k $chunk \
            | neato -Tpdf -n -o $out.tmp.$s
    elif [ "$renderer" == "dot" ];
    then
        nvg find -x $xg -r $s:$e -c $context \
            | nvg mod -z - \
            | nvg view -dpn - \
            | dot -Tpdf -o $out.tmp.$s
    elif [ "$renderer" == "dotnopath" ];
    then
         nvg find -x $xg -r $s:$e -c $context \
             | nvg mod -z - \
             | nvg view -d - \
             | dot -Tpdf -o $out.tmp.$s
    elif [ "$renderer" == "dotnolabels" ];
    then
        nvg find -x $xg -r $s:$e -c $context \
            | nvg mod -u - \
            | nvg mod -K - \
            | nvg mod -cz - \
            | nvg view -d - \
            | dot -Tpdf -o $out.tmp.$s
    fi
    #cairosvg $out.tmp.$s -fpdf -o $out.tmp.$s.pdf
    # also try mars if rendering is problematic
done

echo "combining pdfs"
pdfunite $(ls $out.tmp.* | sort -V) $out

echo "cleaning up"
rm $out.tmp.*
